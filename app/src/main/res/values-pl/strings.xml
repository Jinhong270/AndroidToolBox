    <string name="app_name">ToolBox</string>
    <string name="tb_title">ToolBox</string>
    <string name="welcome_toolbox">Witaj w ToolBox</string>
    <string name="toolbox_desc">Wydajne i bezpieczne narzędzie do zdalnego zarządzania SSH i diagnostyki z wbudowanym menedżerem plików, rozszerzonym terminalem i narzędziami sum kontrolnych.</string>
    <string name="core_features">Główne funkcje</string>
    <string name="ssh_feature_title">Menedżer plików SSH &amp; Terminal</string>
    <string name="ssh_feature_subtitle">Połączenie z serwerem zdalnym, przesyłanie plików SFTP, sterowanie terminalem w czasie rzeczywistym</string>
    <string name="ssh_feature_desc">Obsługuje uwierzytelnianie hasłem/kluczem, podgląd i edycję kodu/tekstu w czasie rzeczywistym, wypakowywanie archiwów, obliczanie MD5/SHA256 oraz interaktywny terminal powłoki.</string>
    <string name="security_notice">Wszystkie poufne dane i poświadczenia komunikują się bezpośrednio z Twoim serwerem i nigdy nie są przechowywane na serwerach firm trzecich.</string>
