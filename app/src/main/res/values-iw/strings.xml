    <string name="agreement_scam_title">קוד פתוח וחינם. עותק בתשלום הוא הונאה</string>
    <string name="agreement_scam_text">ל-ToolBox אין עמלה ואין רכישה מתוך האפליקציה. המקור הרשמי היחיד הוא %1$s. אם שילמתם עליו בפלטפורמה כלשהי, בקשו החזר ודווחו על המוכר.</string>
    <string name="agreement_open_repo">פתיחת המאגר הרשמי %1$s</string>
    <string name="agreement_read_done">הגעתם לסוף ואפשר להמשיך</string>
