    <string name="section_license">רישיון ומחיר</string>
    <string name="license_freedom">חופשי לשימוש, לשינוי ולהפצה</string>
    <string name="about_free_text">התוכנה הזו היא קוד פתוח וחינמית. אין מהדורה בתשלום, אין רכישה מתוך האפליקציה ואין מנוי. המחבר לא יגבה מכם תשלום תחת שום שם ולא זקוק לפרטי תשלום.</string>
    <string name="about_refund_title">שילמתם במקום אחר? בקשו החזר ודווחו</string>
    <string name="about_refund_text">אם שילמתם על האפליקציה הזו בחנות, במארח קבצים, בשיחת קבוצה או בכל ערוץ אחר, בקשו החזר ודווחו על המוכר. ToolBox עצמה חינמית לחלוטין. עותקים בתשלום הם מכירה חוזרת.</string>
    <string name="section_privacy">פרטיות</string>
    <string name="privacy_title">החיבורים לא עוברים דרך צד שלישי</string>
    <string name="privacy_text">הגדרות המארח והסיסמאות נשארות באחסון הפרטי של האפליקציה הזו. חיפושי דומיין הולכים ישירות אל IANA ואל המרשם המתאים. לאפליקציה אין SDK לניתוח, פרסומות או דיווח קריסות, והיא לא שולחת למחבר פרטי מארח, פרטי גישה, תוכן קבצים או היסטוריית חיפוש.</string>
