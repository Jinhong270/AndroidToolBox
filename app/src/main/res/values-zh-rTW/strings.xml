    <string name="app_name">工具箱</string>
    <string name="tb_title">ToolBox 極簡工具箱</string>
    <string name="welcome_toolbox">歡迎使用 ToolBox</string>
    <string name="toolbox_desc">高效、安全的遠端 SSH 管理與診斷工具，內建檔案管理器、增強型終端以及硬體校驗工具。</string>
    <string name="core_features">核心功能模組</string>
    <string name="ssh_feature_title">SSH 檔案管理器 &amp; 終端機</string>
    <string name="ssh_feature_subtitle">遠端伺服器連線、SFTP檔案傳輸、即時終端機控制</string>
    <string name="ssh_feature_desc">支援密碼/私鑰認證、即時程式碼文字預覽與編輯、檔案解壓縮、MD5/SHA256計算以及互動式Shell終端機。</string>
    <string name="security_notice">所有敏感資料與憑證僅直接同伺服器通訊，絕不經過第三方伺服器儲存。</string>

