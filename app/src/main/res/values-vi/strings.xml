<resources>
    <string name="app_name">ToolBox</string>
    <string name="tb_title">ToolBox</string>
    <string name="welcome_toolbox">Chào mừng bạn đến với ToolBox</string>
    <string name="toolbox_desc">Công cụ chẩn đoán và quản lý SSH từ xa hiệu quả và bảo mật, tích hợp trình quản lý tệp, terminal nâng cao và tiện ích tính tổng kiểm tra.</string>
    <string name="core_features">Tính năng chính</string>
    <string name="ssh_feature_title">Trình quản lý tệp SSH &amp; Terminal</string>
    <string name="ssh_feature_subtitle">Kết nối máy chủ từ xa, truyền tệp SFTP, điều khiển terminal thời gian thực</string>
    <string name="ssh_feature_desc">Hỗ trợ xác thực mật khẩu/khóa, xem trước và chỉnh sửa mã/văn bản thời gian thực, giải nén lưu trữ, tính toán MD5/SHA256 và terminal shell tương tác.</string>
    <string name="security_notice">Tất cả dữ liệu nhạy cảm và thông tin xác thực giao tiếp trực tiếp với máy chủ của bạn và không bao giờ được lưu trữ trên máy chủ của bên thứ ba.</string>
